{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "HOST",
    "PORT",
    "CORS_ORIGIN",
    "LOG_LEVEL",
    "NODE_ENV",
    "VITE_API_URL",
    "VITE_API_TARGET",
    "PLAYWRIGHT_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
