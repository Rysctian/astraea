# Database (local Docker Compose defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Web
VITE_API_URL=/api
VITE_API_TARGET=http://localhost:3001
